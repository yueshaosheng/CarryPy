{
  "name": "carrypy-desktop",
  "version": "1.0.1",
  "description": "CarryPy desktop GUI — build minimal Python environments for any Linux distro",
  "main": "./out/main/index.js",
  "author": "yueshaosheng",
  "license": "MIT",
  "homepage": "https://github.com/yueshaosheng/CarryPy",
  "repository": {
    "type": "git",
    "url": "https://github.com/yueshaosheng/CarryPy.git"
  },
  "desktopName": "CarryPy",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:all": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.1",
    "@icon-park/react": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "unocss": "^66.0.0",
    "vite": "^6.3.0"
  }
}